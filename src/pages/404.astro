---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout locale="es" title="Página no encontrada | Tirolesa Mirador del Sol" description="La página solicitada no existe." canonicalPath="/404.html" noindex>
  <main class="mx-auto max-w-3xl px-6 py-24 text-slate-900">
    <p class="text-sm font-semibold uppercase tracking-widest">404</p>
    <h1 class="mt-4 text-4xl font-semibold">Página no encontrada</h1>
    <p class="mt-6">La dirección no corresponde a una página de esta guía.</p>
    <a class="mt-8 inline-block underline" href="/">Volver al inicio</a>
  </main>
</BaseLayout>
