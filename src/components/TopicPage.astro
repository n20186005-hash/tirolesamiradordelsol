---
import { siteMeta, type Locale } from "../data/site";
import { topicList, type TopicContent } from "../data/topics";

interface Props {
  locale: Locale;
  topic: TopicContent;
}

const { locale, topic } = Astro.props;
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? `https://${siteMeta.domain}`;
const canonicalUrl = `${siteOrigin}${topic.canonicalPath}`;

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: topic.title,
  description: topic.description,
  url: canonicalUrl,
  inLanguage: "es",
  isPartOf: { "@type": "WebSite", name: siteMeta.name, url: siteOrigin },
  about: {
    "@type": ["TouristAttraction", "LocalBusiness"],
    name: siteMeta.name,
    address: siteMeta.address,
    geo: {
      "@type": "GeoCoordinates",
      latitude: siteMeta.latitude,
      longitude: siteMeta.longitude,
    },
  },
};

const related = topicList.filter((item) => item.slug !== topic.slug);
const homeHref = locale === "es" ? "/" : `/${locale}/`;
const breadcrumbTrail = [siteMeta.name, topic.hero.headline];
---

<section class="relative isolate overflow-hidden">
  <div class="absolute inset-0 bg-[linear-gradient(180deg,#0f172a,#1e293b)]"></div>
  <div class="relative mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <p class="text-sm font-semibold tracking-[0.18em] text-white/60 uppercase">{topic.hero.eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-white md:text-5xl">{topic.hero.headline}</h1>
    <p class="mt-6 max-w-2xl text-base leading-7 text-white/85 md:text-lg">{topic.hero.summary}</p>
    <p class="mt-4 max-w-2xl text-sm font-semibold leading-6 text-white">Los horarios, precios, requisitos, equipamiento y medidas de seguridad de la tirolesa no han sido verificados con el operador. Confírmalos directamente antes de viajar.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={siteMeta.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-slate-100"
      >
        Ver en Google Maps
      </a>
      <a
        href={homeHref}
        class="rounded-full border border-white/35 px-5 py-3 text-sm font-semibold text-white hover:border-white hover:bg-white/10"
      >
        Volver al inicio
      </a>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
  <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
    <a href={homeHref} class="hover:text-slate-900">Inicio</a>
    <span class="text-slate-300">/</span>
    {breadcrumbTrail.map((crumb) => <span>{crumb}</span>)}
  </nav>
  <p class="mt-6 max-w-3xl text-base leading-7 text-slate-600">{topic.intro}</p>
</section>

{
  topic.sections.map((section) => (
    <section id={section.id} class="border-t border-stone-200/70 bg-white/55">
      <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase">{section.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">{section.title}</h2>
          {section.intro && <p class="mt-5 text-base leading-7 text-slate-600">{section.intro}</p>}
        </div>
        {section.body && (
          <ul class="mt-8 grid gap-3 lg:grid-cols-2">
            {section.body.map((line) => (
              <li class="rounded-2xl border border-stone-200/80 bg-white/85 p-4 text-sm leading-7 text-slate-800 shadow-sm shadow-stone-200/40">
                {line}
              </li>
            ))}
          </ul>
        )}
        {section.cards && (
          <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {section.cards.map((card) => (
              <article class="rounded-[1.75rem] border border-stone-200/80 bg-white/85 p-6 shadow-sm shadow-stone-200/40">
                <h3 class="text-lg font-semibold text-slate-900">{card.title}</h3>
                <p class="mt-4 text-sm leading-7 text-slate-600">{card.body}</p>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  ))
}

{
  topic.slug === "fotos" && (
    <section class="border-t border-stone-200/70 bg-white/55">
      <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase">Galería</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Imágenes del Mirador del Sol</h2>
          <p class="mt-5 text-base leading-7 text-slate-600">
            Una muestra del lugar en distintas horas y condiciones de cielo.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {siteMeta.galleryImages.map((image) => (
            <figure class="group overflow-hidden rounded-[1.5rem] border border-stone-200/70 bg-stone-100 shadow-sm shadow-stone-200/50">
              <picture>
                <source srcset={image.webp} type="image/webp" />
                <img
                  src={image.src}
                  alt={`Mirador del Sol, ${siteMeta.cityFull}, ${siteMeta.state} — imagen ${image.index}`}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                />
              </picture>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<section id="faq" class="border-t border-stone-200/70 bg-white/55">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase">Preguntas frecuentes</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">{topic.faq.title}</h2>
      <p class="mt-5 text-base leading-7 text-slate-600">{topic.faq.intro}</p>
    </div>
    <div class="mt-12 flex flex-col gap-12">
      {
        topic.faq.groups.map((group) => (
          <div>
            <h3 class="text-xl font-bold text-slate-900 mb-6 flex items-center gap-3">
              <span class="w-1.5 h-6 bg-slate-800 rounded-full"></span>
              {group.category}
            </h3>
            <div class="grid gap-4">
              {group.items.map((item) => (
                <details class="group rounded-[1.5rem] border border-stone-200/80 bg-white/90 p-6 shadow-sm shadow-stone-200/30">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left text-lg font-semibold text-slate-900">
                    <span>{item.question}</span>
                    <span class="mt-1 text-slate-400 transition group-open:rotate-45">+</span>
                  </summary>
                  <p class="mt-4 text-sm leading-7 text-slate-600">{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="border-t border-stone-200/70">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-slate-500 uppercase">Seguí explorando</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-950">Páginas relacionadas</h2>
      <p class="mt-5 text-base leading-7 text-slate-600">Complementá esta guía con otras secciones sobre el Mirador del Sol.</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        related.map((item) => (
          <a
            href={item.canonicalPath}
            class="rounded-[1.75rem] border border-stone-200/80 bg-white/85 p-6 shadow-sm shadow-stone-200/40 hover:border-slate-400"
          >
            <h3 class="text-lg font-semibold text-slate-900">{item.hero.headline}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-600">{item.hero.summary}</p>
          </a>
        ))
      }
      <a
        href={homeHref}
        class="rounded-[1.75rem] border border-stone-200/80 bg-[#f7f5ef] p-6 shadow-sm shadow-stone-200/40 hover:border-slate-400"
      >
        <h3 class="text-lg font-semibold text-slate-900">Guía completa del Mirador del Sol</h3>
        <p class="mt-4 text-sm leading-7 text-slate-600">Volvé a la página principal con clima, historia y todos los detalles.</p>
      </a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

