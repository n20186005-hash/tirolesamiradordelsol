---
import "../styles/global.css";
import { alternateLinks, localizedPath, siteMeta, type Locale } from "../data/site";

interface FaqGroup {
  category: string;
  items: Array<{ question: string; answer: string }>;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath?: string;
  alternateUrls?: Array<{ href: string; hreflang: string }>;
  structuredData?: Record<string, unknown> | null;
  faqGroups?: FaqGroup[];
  preloadImage?: string;
}

const { locale, title, description, canonicalPath: customCanonicalPath, alternateUrls, structuredData, faqGroups, preloadImage } = Astro.props;
const canonicalPath = customCanonicalPath ?? localizedPath(locale);
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? `https://${siteMeta.domain}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const businessId = `${siteOrigin}/#business`;
const heroImageUrl = `${siteOrigin}${siteMeta.heroImage}`;
const ogImageUrl = `${siteOrigin}${siteMeta.ogImage}`;
const languageTag: Record<Locale, string> = {
  zh: "zh-CN",
  en: "en",
  it: "it",
  es: "es",
};

const tourismSchema = {
  "@context": "https://schema.org",
  "@type": ["TouristAttraction", "LocalBusiness"],
  "@id": businessId,
  name: siteMeta.name,
  alternateName: [siteMeta.shortName, `${siteMeta.cityFull} ${siteMeta.name}`],
  description,
  url: canonicalUrl,
  image: [heroImageUrl, ogImageUrl],
  telephone: siteMeta.phoneIntl,
  isAccessibleForFree: true,
  publicAccess: true,
  sameAs: [siteMeta.mapsUrl, siteMeta.merloTourismUrl, siteMeta.govtTourismUrl],
  hasMap: siteMeta.mapsUrl,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Ruta Provincial 5 s/n",
    addressLocality: siteMeta.cityFull,
    addressRegion: siteMeta.state,
    addressCountry: siteMeta.countryCode,
    postalCode: siteMeta.postalCode,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: siteMeta.latitude,
    longitude: siteMeta.longitude,
  },
  touristType: ["Aventura", "Familias", "Fotografía"],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: siteMeta.rating,
    reviewCount: siteMeta.reviewCount.replace(",", ""),
    bestRating: "5",
    worstRating: "1",
  },
};
const pageStructuredData = structuredData === undefined ? tourismSchema : structuredData;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: siteMeta.country, item: siteOrigin },
    { "@type": "ListItem", position: 2, name: siteMeta.state },
    { "@type": "ListItem", position: 3, name: siteMeta.city },
    { "@type": "ListItem", position: 4, name: siteMeta.name, item: canonicalUrl },
  ],
};

const faqSchema =
  faqGroups && faqGroups.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqGroups.flatMap((group) =>
          group.items.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: { "@type": "Answer", text: item.answer },
          })),
        ),
      }
    : null;

const resolvedAlternateUrls =
  alternateUrls ??
  alternateLinks.map((item) => ({
    hreflang: item.locale === "zh" ? "zh-CN" : item.locale,
    href: `${siteOrigin}${item.href}`,
  }));
---

<!doctype html>
<html lang={languageTag[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={`${siteMeta.name} guide`} />
    <link rel="canonical" href={canonicalUrl} />

    {
      resolvedAlternateUrls.map((item) => (
        <link rel="alternate" hreflang={item.hreflang} href={item.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />

    <!-- Icons & PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={siteMeta.shortName} />
    <meta name="application-name" content={siteMeta.shortName} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:locale" content={languageTag[locale].replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteMeta.name} in ${siteMeta.city}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Performance hints -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://api.open-meteo.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    {pageStructuredData && <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Google Analytics 4 (consent mode: analytics stays denied until the visitor opts in) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        wait_for_update: 500,
      });
      try {
        var stored = window.localStorage.getItem("site-cookie-preferences");
        if (stored) {
          var prefs = JSON.parse(stored);
          if (prefs && prefs.analytics) {
            gtag("consent", "update", { analytics_storage: "granted" });
          }
        }
      } catch (error) {}
      gtag("js", new Date());
      gtag("config", "G-HXM22WWPKP", { anonymize_ip: true });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.addEventListener("site-cookie-preferences", function (event) {
        var prefs = (event && event.detail) || {};
        if (typeof window.gtag === "function") {
          window.gtag("consent", "update", {
            analytics_storage: prefs.analytics ? "granted" : "denied",
          });
        }
      });
    </script>

    <!-- Progressive Web App -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
